{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "companyName",
    "website",
    "domain",
    "confidence",
    "summary",
    "sourceUrls",
    "publicExecutives"
  ],
  "properties": {
    "companyName": {
      "type": "string",
      "description": "The resolved legal, trading, or commonly used company name."
    },
    "website": {
      "type": "string",
      "description": "The most likely official website URL, including protocol when known."
    },
    "domain": {
      "type": "string",
      "description": "The official company website domain without protocol or path."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "description": "Brief company identity summary from public sources."
    },
    "sourceUrls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publicExecutives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "linkedinUrl", "email", "emailType", "emailSource", "emailSourceUrls", "sourceUrls", "confidence"],
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "linkedinUrl": {
            "type": "string",
            "description": "The executive's LinkedIn profile URL, or an empty string if not verified."
          },
          "email": {
            "type": "string",
            "description": "A public professional email address for the executive, or an empty string if not verified."
          },
          "emailType": {
            "type": "string",
            "enum": ["", "public_work", "public_generic", "public_unknown", "apollo_work", "apollo_personal"],
            "description": "Classify the email source/type."
          },
          "emailSource": {
            "type": "string",
            "enum": ["", "codex_public", "apollo"],
            "description": "Where the email came from."
          },
          "emailSourceUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
