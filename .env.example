PORT=3000
NODE_ENV=development

# Optional inbound webhook protection. When set, callers must send:
# Authorization: Bearer <WEBHOOK_AUTH_TOKEN>
WEBHOOK_AUTH_TOKEN=

# Used to sign outbound callbacks with X-Webhook-Signature.
CALLBACK_SECRET=

# Apollo.io API settings.
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1
APOLLO_PEOPLE_SEARCH_PATH=/mixed_people/api_search
APOLLO_INCLUDE_EMAILS=false
APOLLO_TIMEOUT_MS=30000
APOLLO_ENRICH_PEOPLE=true
APOLLO_PEOPLE_ENRICHMENT_PATH=/people/match
APOLLO_ENRICH_LIMIT=10

# Codex CLI settings. The server shells out to this binary.
CODEX_BIN=codex
CODEX_MODEL=
CODEX_PROFILE=
CODEX_SANDBOX=read-only
CODEX_LIVE_SEARCH=true
CODEX_VISIBLE_TERMINAL=false
CODEX_VISIBLE_TERMINAL_HOLD=true
CODEX_ENABLE_APOLLO_MCP=true
CODEX_APOLLO_MCP_REQUIRED=true
CODEX_TIMEOUT_MS=900000
CODEX_WORKDIR=./codex-workdir

# Worker limits.
MAX_CONCURRENT_JOBS=2
JOB_RETENTION_MS=86400000
