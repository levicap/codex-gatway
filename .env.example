PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Required. Callers send Authorization: Bearer <RESEARCH_API_KEY>.
RESEARCH_API_KEY=

# Outbound callbacks are disabled unless both an HTTPS host allowlist and
# a signing secret are configured. Wildcards such as *.example.com are allowed.
CALLBACK_SECRET=
CALLBACK_ALLOWED_HOSTS=hooks.example.com
CALLBACK_TIMEOUT_MS=15000

# Per-IP and per-key fixed-window request limits.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# OpenClaw is the default worker. It connects to the private local Gateway.
RESEARCH_ENGINE=openclaw
RESEARCH_MODEL=openai/gpt-5.6-terra
OPENCLAW_BIN=openclaw
OPENCLAW_AGENT=lead-research
OPENCLAW_THINKING=medium
OPENCLAW_TIMEOUT_SECONDS=600
OPENCLAW_KILL_GRACE_MS=60000
OPENCLAW_MAX_OUTPUT_BYTES=10485760

# Temporary one-release rollback worker: set RESEARCH_ENGINE=codex.
CODEX_BIN=codex
CODEX_MODEL=
CODEX_PROFILE=
CODEX_SANDBOX=read-only
CODEX_LIVE_SEARCH=true
CODEX_TIMEOUT_MS=900000
CODEX_WORKDIR=./codex-workdir

# Persistent queue and retention.
JOBS_DATABASE_PATH=./data/jobs.sqlite
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=100
JOB_RETENTION_MS=86400000
